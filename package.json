{
  "name": "suidouyasan-3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply suidouyasan --local",
    "db:migrate:remote": "wrangler d1 migrations apply suidouyasan --remote",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "motion": "^11.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
